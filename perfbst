usage() {
  cat <<EOF
${C_BOLD}${SCRIPT_NAME}${C_RESET} — Universal System & Process Performance Accelerator

${C_CYAN}Commands:${C_RESET}
  ${C_BOLD}sudo ${SCRIPT_NAME} setup${C_RESET}                 Optimize the entire system for maximum performance
                                   (CPU governor, sysctl, environment multi-threading,
                                    zram, pigz/pbzip2 drop-ins, and auto-booster daemon)
  ${C_BOLD}${SCRIPT_NAME} run <command...> [args]${C_RESET}     Execute ANY arbitrary process with boosted CPU/IO
                                   priority, affinity, and multi-thread limits
  ${C_BOLD}${SCRIPT_NAME} status${C_RESET}                      Display current system performance & tuning status
  ${C_BOLD}sudo ${SCRIPT_NAME} daemon {start|stop|status}${C_RESET} Manage the background process booster daemon
  ${C_BOLD}sudo ${SCRIPT_NAME} apt-upgrade${C_RESET}               Parallel-downloaded full system package upgrade
  ${C_BOLD}sudo ${SCRIPT_NAME} apt-install <pkg...>${C_RESET}      Install apt packages with parallel segmented downloads
  ${C_BOLD}${SCRIPT_NAME} pip-install <pkg...>${C_RESET}          Install pip packages in parallel with load throttling
  ${C_BOLD}sudo ${SCRIPT_NAME} --uninstall${C_RESET}               Revert all changes and restore original defaults

${C_CYAN}Examples:${C_RESET}
  sudo ${SCRIPT_NAME} setup
  ${SCRIPT_NAME} run make -j8
  ${SCRIPT_NAME} run ffmpeg -i video.mov output.mp4
  ${SCRIPT_NAME} run python3 train.py
  ${SCRIPT_NAME} status
  sudo ${SCRIPT_NAME} apt-install build-essential cmake git
  ${SCRIPT_NAME} pip-install numpy scipy torch torchvision
  sudo ${SCRIPT_NAME} --uninstall
EOF
}

main() {
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  touch "$LOG_FILE" 2>/dev/null || LOG_FILE="/tmp/${SCRIPT_NAME}.log"

  [[ $# -eq 0 ]] && { usage; exit 1; }

  case "$1" in
    setup)                 shift; cmd_setup "$@";;
    run)                   shift; cmd_run "$@";;
    status)                shift; cmd_status "$@";;
    daemon)                shift; cmd_daemon "$@";;
    daemon-loop)           daemon_loop;;
    apt-upgrade)           shift; cmd_apt_upgrade "$@";;
    apt-install)           shift; cmd_apt_install "$@";;
    pip-install)           shift; cmd_pip_install "$@";;
    --uninstall|uninstall) cmd_uninstall;;
    -h|--help)             usage;;
    *)                     err "Unknown command: $1"; usage; exit 1;;
  esac
}

main "$@"
